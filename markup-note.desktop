[Desktop Entry]
Name=Markup Notes
Comment=Notes App for Electron haters
Exec=sh -c 'DIR="$(dirname "$(readlink -f "$1")")"; exec python3 "$DIR/main.py"' _ %k
Icon=markup-notes
Terminal=false
Type=Application
Categories=Office;Utility;TextEditor;
Keywords=markdown;notes;editor;text;
StartupNotify=true
MimeType=text/markdown;text/plain;
